+theorem foldl_samLinesB (chromosomes : ChromosomeList) (l : List ((FastqRecord × FastqRecord) × PairResult))
+    (h : ∀ x ∈ l, RecordAscii x.1.1 ∧ RecordAscii x.1.2) : ∀ text : String,
+    l.foldl (fun bytes ((record1, record2), result) => samLinesB bytes chromosomes record1 record2 result) text.toUTF8 =
+      (l.foldl (fun text ((record1, record2), result) => linesText (samLines chromosomes record1 record2 result) text) text).toUTF8 := by
+  induction l with
+  | nil => intro text; rfl
+  | cons x l ih =>
+    intro text
+    obtain ⟨⟨r1, r2⟩, result⟩ := x
+    have hx := h _ (List.mem_cons_self ..)
+    simp only [List.foldl_cons]
+    have : samLinesB text.toUTF8 chromosomes r1 r2 result =
+        (linesText (samLines chromosomes r1 r2 result) text).toUTF8 := by
+      rw [samLinesB_eq _ _ _ _ _ hx.1 hx.2, linesText_append (samLines chromosomes r1 r2 result) text]
