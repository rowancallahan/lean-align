+-- the two SAM lines of one pair (with their newlines) appended to `b`
+def samLinesB (b : ByteArray) (chromosomes : ChromosomeList) (record1 record2 : FastqRecord) (result : PairResult) :
+    ByteArray :=
+  match result with
+  | .trimmedAway mate =>
+      let tags := [s!"XT:Z:trimmedAway{if mate = .one then 1 else 2}"]
+      (unmappedLineB b record1 .one tags).push 10 |> (unmappedLineB · record2 .two tags) |>.push 10
+  | .aligned answer =>
+      match answer.found with
+      | some pair =>
+          (mappedLineB b chromosomes record1 .one pair.mate1 pair.mate2 answer).push 10
+            |> (mappedLineB · chromosomes record2 .two pair.mate2 pair.mate1 answer) |>.push 10
+      | none =>
+          (unmappedLineB b record1 .one (answerTags answer)).push 10
+            |> (unmappedLineB · record2 .two (answerTags answer)) |>.push 10
+
+-- `samChunk` with the byte writer
+def samChunkB (chromosomes : ChromosomeList) (chunk : Array (FastqRecord × FastqRecord))
+    (results : List PairResult) (parts : Nat) : ByteArray :=
+  let pairs := chunk.zip results.toArray
+  let size := (pairs.size + parts - 1) / parts
+  let tasks := (List.range parts).map fun part => Task.spawn fun _ =>
+    (pairs.extract (part * size) ((part + 1) * size)).foldl (init := ByteArray.empty)
+      fun bytes ((record1, record2), result) => samLinesB bytes chromosomes record1 record2 result
+  tasks.foldl (fun bytes task => bytes ++ task.get) ByteArray.empty
+
