+
+/-! ## PROTOTYPE (local, unproved): a pipeline that keeps every core busy
+
+Two readers (one per mate file) cut their input into slices of exactly `jobPairs` records (every `4 · jobPairs`-th
+newline), with no parsing. A dispatcher pairs slice k of each file into job k. `workers` workers each parse and check
+their job's records (as `readChunk` does), trim them (`trimRecord`), align them, and format the SAM bytes. The writer
+(the main thread) writes the jobs in sequence order. -/
+namespace Pipe
+open Spec
+
+def blockSize : Nat := 8 * 1024 * 1024
+def jobPairs : Nat := 16000
+def workers : Nat := 4
+-- jobs queued per worker
+def depth : Nat := 2
+
+-- the quality length in bytes, whether `FastqRecord.quality` is a String or (with shim_speed.patch) a ByteArray
+class QSize (α : Type) where qsize : α → Nat
+instance : QSize String := ⟨String.utf8ByteSize⟩
+instance : QSize ByteArray := ⟨ByteArray.size⟩
+
+-- up to 8 MB; short (pipe) reads are topped up, 1 MB at a time, until the block is full or the input ends
+def readBig (h : IO.FS.Handle) : IO ByteArray := do
+  let mut block ← h.read blockSize.toUSize
+  if block.isEmpty then return block
+  repeat
+    if blockSize ≤ block.size then break
+    let more ← h.read (min (1024 * 1024) (blockSize - block.size)).toUSize
+    if more.isEmpty then break
+    block := block ++ more
+  return block
+
+-- one past the `n`-th newline at or after `i`, and how many newlines were found (fewer than `n`: up to the end)
+def cutAfter (b : ByteArray) (i n : Nat) : Nat × Nat := Id.run do
+  let mut p := i
+  let mut f := 0
+  for _ in [0:n] do
+    let j := findNewline b p
+    if j < b.size then
+      p := j + 1
+      f := f + 1
+    else
+      p := b.size
+      break
+  return (p, f)
+
+def die (what : String) (e : IO.Error) : IO Unit := do
+  IO.eprintln s!"{what}: {e}"
+  IO.Process.exit 1
+
+-- slices of exactly `jobPairs` records (the last one may be shorter), in file order
+def reader (h : IO.FS.Handle) (k : Nat) (ch : Std.CloseableChannel.Sync ByteArray) : IO Unit := do
+  let need := 4 * k
+  let mut carry := ByteArray.empty
+  let mut scan := 0
+  let mut lines := 0
+  let mut eof := false
+  repeat
+    let (p, f) := cutAfter carry scan (need - lines)
+    if lines + f = need then
+      ch.send (carry.extract 0 p)
+      carry := carry.extract p carry.size
+      scan := 0
+      lines := 0
+    else
+      scan := carry.size
+      lines := lines + f
+      if eof then
+        if 0 < carry.size then
+          -- `lines` counts a last line without "\n": end the file with one
+          ch.send (if carry[carry.size - 1]! == 10 then carry else carry.push 10)
+        break
+      let blk ← readBig h
+      if blk.isEmpty then eof := true else carry := carry ++ blk
+  ch.close
+
+-- the first space at or after `i` (or the end), as a structural scan
+def spaceAt (h : ByteArray) : (fuel i : Nat) → Nat
+  | 0, i => i
+  | f + 1, i => if i < h.size && h[i]! != 32 then spaceAt h f (i + 1) else i
+
+-- `qnameOf (header.extract 1 header.size)` (ProvisionalSpec.lean) on the header bytes: the text after '@' up to the
+-- first space, without a trailing "/1" or "/2" (the same as `mateName` of the record's name, `parseRecord` having
+-- checked that the header is printable ASCII)
+def qnameBytes (header : ByteArray) : ByteArray :=
+  let e := spaceAt header header.size 1
+  if 3 ≤ e && header[e - 2]! == 47 && (header[e - 1]! == 49 || header[e - 1]! == 50) then header.extract 1 (e - 2)
+  else header.extract 1 e
+
+-- a SAM QNAME: 1..254 bytes, each in '!'..'?' or 'A'..'~' (`isQnameByte`)
+def qnameOk (q : ByteArray) : Bool :=
+  0 < q.size && q.size ≤ 254 && q.data.all fun c => (33 ≤ c && c ≤ 63) || (65 ≤ c && c ≤ 126)
+
+-- the line at `i` without its "\n" / "\r\n" (`lines`), and where the next one starts
+def lineAt (b : ByteArray) (i : Nat) : ByteArray × Nat :=
+  let j := findNewline b i
+  let stop := if i < j && b[j - 1]! == 13 then j - 1 else j
+  (b.extract i stop, j + 1)
+
+-- `parseLines (lines b)` from byte `i` on, each record with its QNAME bytes; a structural recursion (fuel: one record
+-- per step, at most `b.size` records)
+def parseFrom (b : ByteArray) : (fuel i : Nat) → Array (FastqRecord × ByteArray) →
+    Except String (Array (FastqRecord × ByteArray))
+  | 0, _, acc => .ok acc
+  | f + 1, i, acc =>
+    if b.size ≤ i then .ok acc else
+    let (header, i1) := lineAt b i
+    if b.size ≤ i1 then .error "FASTQ: file ends inside a record" else
+    let (letters, i2) := lineAt b i1
+    if b.size ≤ i2 then .error "FASTQ: file ends inside a record" else
+    let (plus, i3) := lineAt b i2
+    if b.size ≤ i3 then .error "FASTQ: file ends inside a record" else
+    let (quality, i4) := lineAt b i3
+    match parseRecord header letters plus quality with
+    | .ok record => parseFrom b f i4 (acc.push (record, qnameBytes header))
+    | .error why => .error s!"FASTQ: {why}"
+
+-- the records of a slice (the reader's slices end with "\n": the last one gets one appended at the end of the file)
+def parseSlice (b : ByteArray) : IO (Array (FastqRecord × ByteArray)) := IO.ofExcept (parseFrom b b.size 0 #[])
+
+-- `readChunk`'s pair checks, on the name bytes
+def pairUp (r1 r2 : Array (FastqRecord × ByteArray)) : IO (Array (FastqRecord × FastqRecord)) := do
+  let mut chunk := #[]
+  for ((record1, q1), (record2, q2)) in r1.zip r2 do
+    if q1 != q2 then
+      throw (IO.userError s!"FASTQ files out of step: mate names {record1.name} / {record2.name}")
+    for (record, q) in [(record1, q1), (record2, q2)] do
+      unless qnameOk q do
+        throw (IO.userError s!"FASTQ: read name '{record.name}' is not a SAM QNAME")
+    if record1.letters.size != QSize.qsize record1.quality || record2.letters.size != QSize.qsize record2.quality then
+      throw (IO.userError s!"FASTQ record {record1.name}: sequence and quality lengths differ")
+    chunk := chunk.push (record1, record2)
+  if r1.size != r2.size then
+    throw (IO.userError "FASTQ files out of step: one file has more reads than the other")
+  return chunk
+
+def worker (ins : InsertSettings) (index : ByteArray) (chromosomes : ChromosomeList)
+    (jobs : Std.CloseableChannel.Sync (Nat × ByteArray × ByteArray))
+    (out : Std.CloseableChannel.Sync (Nat × ByteArray)) : IO Unit := do
+  -- PROTOTYPE variant B (PIPE_B=1): the index view and router setup built once per worker, `alignOneP` per pair
+  -- (what `alignPairs` runs per pair: `alignPairs_eqC`); Spec has no interface for it yet
+  let vb := (← IO.getEnv "PIPE_B") == some "1"
+  let (chroms0, loaded) := if vb then readIndex index else (none, none)
+  let chroms := chroms0.getD []
+  let setup := (chunkSetup ins loaded).map withMono
+  repeat
+    let some (seq, b1, b2) ← jobs.recv | break
+    let chunk ← pairUp (← parseSlice b1) (← parseSlice b2)
+    let chunk := chunk.map fun (record1, record2) => (trimRecord record1, trimRecord record2)
+    let results := if vb then (chunkPairs chunk).map (fun (x, y) => alignOneP ins chroms setup x y)
+      else alignPairs ins index (chunkPairs chunk)
+    out.send (seq, samChunkB chromosomes chunk results 1)
+
+def run (ins : InsertSettings) (index : ByteArray) (chromosomes : ChromosomeList) (h1 h2 : IO.FS.Handle)
+    (outH : IO.FS.Handle) : IO Unit := do
+  -- PROTOTYPE knobs for the measurements (defaults: jobPairs, depth)
+  let k := ((← IO.getEnv "PIPE_JOB").bind String.toNat?).getD jobPairs
+  let d := ((← IO.getEnv "PIPE_DEPTH").bind String.toNat?).getD depth
+  let ch1 ← Std.CloseableChannel.Sync.new (some 3)
+  let ch2 ← Std.CloseableChannel.Sync.new (some 3)
+  let jobs ← Std.CloseableChannel.Sync.new (some (d * workers))
+  let res ← Std.CloseableChannel.Sync.new (some (4 * workers))
+  let _ ← IO.asTask (prio := .dedicated) (try reader h1 k ch1 catch e => die "reader 1" e)
+  let _ ← IO.asTask (prio := .dedicated) (try reader h2 k ch2 catch e => die "reader 2" e)
+  let _ ← IO.asTask (prio := .dedicated) (try
+      let mut seq := 0
+      repeat
+        let a ← ch1.recv
+        let b ← ch2.recv
+        match a, b with
+        | some x, some y =>
+          jobs.send (seq, x, y)
+          seq := seq + 1
+        | none, none => break
+        | _, _ => throw (IO.userError "FASTQ files out of step: one file has more reads than the other")
+      jobs.close
+    catch e => die "dispatcher" e)
+  let ws ← (List.range workers).mapM fun _ =>
+    IO.asTask (prio := .dedicated) (try worker ins index chromosomes jobs res catch e => die "worker" e)
+  let _ ← IO.asTask (prio := .dedicated) (do
+    for w in ws do let _ ← IO.wait w
+    res.close)
+  let mut pending : Std.HashMap Nat ByteArray := {}
+  let mut nextSeq := 0
+  repeat
+    let some (s, text) ← res.recv | break
+    pending := pending.insert s text
+    repeat
+      match pending[nextSeq]? with
+      | some t =>
+        outH.write t
+        pending := pending.erase nextSeq
+        nextSeq := nextSeq + 1
+      | none => break
+  unless pending.isEmpty do throw (IO.userError "pipeline: results missing")
+
+end Pipe
+
