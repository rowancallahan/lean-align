diff --git a/Proofs/Fastq.lean b/Proofs/Fastq.lean
index c47adb8..eddf6b2 100644
--- a/Proofs/Fastq.lean
+++ b/Proofs/Fastq.lean
@@ -110,8 +110,8 @@ def trimRecord (record : FastqRecord) : FastqRecord :=
   let (letters, qual) := AdapterTrim.dropShort minLength letters qual
   { record with letters, quality := String.fromUTF8! qual }
 
--- up to `size` pairs, reading the two FASTQ files in step; stops with an error if two mates'
--- names differ or one file ends before the other (the files are out of step)
+-- up to `size` pairs, reading the two FASTQ files in step, UNTRIMMED (`trimChunk` trims them); stops with an
+-- error if two mates' names differ or one file ends before the other (the files are out of step)
 def readChunk (reads1 reads2 : FastqReader) (size : Nat) : IO (Array (FastqRecord × FastqRecord)) := do
   let mut chunk := #[]
   for _ in [0:size] do
@@ -125,9 +125,19 @@ def readChunk (reads1 reads2 : FastqReader) (size : Nat) : IO (Array (FastqRecor
           throw (IO.userError s!"FASTQ: read name '{record.name}' is not a SAM QNAME")
       if record1.letters.size != record1.quality.utf8ByteSize || record2.letters.size != record2.quality.utf8ByteSize then
         throw (IO.userError s!"FASTQ record {record1.name}: sequence and quality lengths differ")
-      chunk := chunk.push (trimRecord record1, trimRecord record2)
+      chunk := chunk.push (record1, record2)
     | none, none => break
     | _, _ => throw (IO.userError "FASTQ files out of step: one file has more reads than the other")
   return chunk
 
+-- both mates of every pair trimmed (`trimRecord`), the chunk cut into `parts` slices of `⌈size / parts⌉` pairs, each
+-- slice trimmed in its own task, the slices concatenated in order (`Proofs/TrimRecord.lean`, `trimChunk_eq`: the same
+-- as trimming pair by pair)
+def trimChunk (chunk : Array (FastqRecord × FastqRecord)) (parts : Nat) : Array (FastqRecord × FastqRecord) :=
+  let b := (chunk.size + max parts 1 - 1) / max parts 1
+  let tasks := (List.range (max parts 1)).map fun t =>
+    Task.spawn (prio := .dedicated) fun _ =>
+      (chunk.extract (t * b) ((t + 1) * b)).map fun (record1, record2) => (trimRecord record1, trimRecord record2)
+  tasks.foldl (fun acc t => acc ++ t.get) #[]
+
 end Spec
diff --git a/Proofs/TrimRecord.lean b/Proofs/TrimRecord.lean
index 7c3fc58..4c34eb2 100644
--- a/Proofs/TrimRecord.lean
+++ b/Proofs/TrimRecord.lean
@@ -1,4 +1,5 @@
 import Proofs.Fastq
+import ParMap
 
 /-! # `trimRecord` composes: what the FASTQ glue's trimming guarantees
 
@@ -234,3 +235,16 @@ end Spec
 #print axioms Spec.trimBytes_size
 #print axioms Spec.cutAt_spec
 #print axioms Spec.trimRecord_quality_bytes
+
+namespace Spec
+
+/-- **`trimChunk` trims pair by pair**: the parallel slices give the same chunk as mapping `trimRecord` over both
+mates (`ParMap.parMap_eq_map`). -/
+theorem trimChunk_eq (chunk : Array (FastqRecord × FastqRecord)) (parts : Nat) :
+    trimChunk chunk parts = chunk.map fun (record1, record2) => (trimRecord record1, trimRecord record2) := by
+  rw [← ParMap.parMap_eq_map parts]
+  rfl
+
+end Spec
+
+#print axioms Spec.trimChunk_eq
