+/-- PROTOTYPE: `svAny` on a rolling window (`a` = the 32 fields at the offset, `b` = the next `c` fields of word `u`). -/
+def svAnyR (gs : GW) (sv : UInt64) (k : USize) (a b : UInt64) (c u : USize) : Bool :=
