FASTQ reader read-ahead patch (NOT applied; Spec/Fastq.lean + its mirror Proofs/Fastq.lean; no frozen file, no proof touched).
   git apply Testing/notes/reader_readahead.patch
Made against festive-fermi b85bbf7 (applies to 636ec80). Each FastqReader reads its next 4 MB block in a dedicated task
while the current block is parsed; a short read (pipe) is topped up to 4 MB. See Testing/notes/UTILIZATION.md.

diff --git a/Proofs/Fastq.lean b/Proofs/Fastq.lean
index d6dfbf6..97ca38d 100644
--- a/Proofs/Fastq.lean
+++ b/Proofs/Fastq.lean
@@ -20,9 +20,25 @@ structure FastqReader where
   handle : IO.FS.Handle
   buffer : IO.Ref ByteArray
   pos    : IO.Ref Nat
-
-def FastqReader.ofHandle (handle : IO.FS.Handle) : IO FastqReader :=
-  return { handle, buffer := ← IO.mkRef ByteArray.empty, pos := ← IO.mkRef 0 }
+  -- the next block, read ahead in its own dedicated task (both mates' inputs keep flowing while records are parsed;
+  -- with two pipes, e.g. zcat FIFOs, the producers otherwise wait on each other)
+  next   : IO.Ref (Task (Except IO.Error ByteArray))
+
+-- up to 4 MB: a short read (a pipe returns at most its buffer) is topped up until 4 MB or the end of the input
+def readBlock (handle : IO.FS.Handle) : IO ByteArray := do
+  let first ← handle.read (4 * 1024 * 1024)
+  let mut block := first
+  if 0 < first.size && first.size < 4 * 1024 * 1024 then
+    repeat
+      if 4 * 1024 * 1024 ≤ block.size then break
+      let more ← handle.read 65536
+      if more.isEmpty then break
+      block := block ++ more
+  return block
+
+def FastqReader.ofHandle (handle : IO.FS.Handle) : IO FastqReader := do
+  let t ← IO.asTask (prio := .dedicated) (readBlock handle)
+  return { handle, buffer := ← IO.mkRef ByteArray.empty, pos := ← IO.mkRef 0, next := ← IO.mkRef t }
 
 -- the first newline byte at or after `i` (or `bytes.size` when there is none)
 def findNewline (bytes : ByteArray) (i : Nat) : Nat := Id.run do
@@ -41,7 +57,9 @@ def FastqReader.line (reader : FastqReader) : IO (Option ByteArray) := do
       reader.pos.set (newline + 1)
       let stop := if pos < newline && buffer[newline - 1]! == 13 then newline - 1 else newline
       return some (buffer.extract pos stop)
-    let block ← reader.handle.read (4 * 1024 * 1024)
+    let block ← IO.ofExcept (← reader.next.get).get
+    if !block.isEmpty then
+      reader.next.set (← IO.asTask (prio := .dedicated) (readBlock reader.handle))
     if block.isEmpty then
       reader.buffer.set ByteArray.empty
       reader.pos.set 0
