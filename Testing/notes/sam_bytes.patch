@@ -0,0 +1,284 @@
+import Proofs.Sam
+
+/-! # The byte SAM writer equals the String one (Spec/Sam.lean: `pushNat`, `samLineB`, ..., `samChunkB`).
+`samChunkB_eq`: for chunks whose letters and qualities are ASCII (the FASTQ reader checks `isDnaByte` and `'!'..'~'`),
+`samChunkB = samChunk`. -/
+
+namespace Spec
+
+theorem push_append (b c : ByteArray) (x : UInt8) : (b ++ c).push x = b ++ c.push x := by
+  rw [← ByteArray.append_toByteArray_singleton, ← ByteArray.append_toByteArray_singleton, ByteArray.append_assoc]
+
+theorem digit_bytes (d : Nat) (h : d < 10) :
+    (String.ofList [Nat.digitChar d]).toByteArray = [48 + d.toUInt8].toByteArray := by
+  have : d = 0 ∨ d = 1 ∨ d = 2 ∨ d = 3 ∨ d = 4 ∨ d = 5 ∨ d = 6 ∨ d = 7 ∨ d = 8 ∨ d = 9 := by omega
+  rcases this with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> rfl
+
+theorem pushNat_eq (n : Nat) : ∀ b : ByteArray, pushNat b n = b ++ (toString n).toUTF8 := by
+  induction n using Nat.strongRecOn with
+  | _ n ih =>
+    intro b
+    rw [pushNat]
+    split
+    · rename_i h
+      have : toString n = String.ofList [Nat.digitChar n] := by
+        show Nat.repr n = _
+        rw [Nat.repr, Nat.toDigits_of_lt_base h]
+      rw [this]
+      simp only [String.toUTF8_eq_toByteArray, digit_bytes n h]
+      simp
+    · rename_i h
+      have h10 : 1 < 10 := by decide
+      have hd : n % 10 < 10 := Nat.mod_lt _ (by decide)
+      have key : toString n = toString (n / 10) ++ String.ofList [Nat.digitChar (n % 10)] := by
+        show Nat.repr n = Nat.repr (n / 10) ++ _
+        rw [Nat.repr, Nat.repr, Nat.toDigits_of_base_le h10 (by omega)]
+        simp [String.ofList_append]
+      rw [ih (n / 10) (by omega), key]
+      simp only [String.toUTF8_eq_toByteArray, String.toByteArray_append, digit_bytes _ hd]
+      simp [push_append]
+
+theorem pushInt_eq (b : ByteArray) (i : Int) : pushInt b i = b ++ (toString i).toUTF8 := by
+  unfold pushInt
+  cases i with
+  | ofNat m =>
+    simp only [Int.ofNat_eq_natCast, Int.natCast_nonneg, Int.not_lt.mpr, if_false, Int.toNat_natCast]
+    rw [pushNat_eq]
+    rfl
+  | negSucc m =>
+    simp only [Int.natAbs_negSucc]
+    rw [if_pos (Int.negSucc_lt_zero m), pushNat_eq]
+    show _ = b ++ (Int.repr (Int.negSucc m)).toUTF8
+    simp only [Int.repr, String.toUTF8_eq_toByteArray, String.toByteArray_append]
+    have h1 : "-".toByteArray = [45].toByteArray := by decide
+    have h2 : (toString (Nat.succ m)).toByteArray = (Nat.succ m).repr.toByteArray := rfl
+    rw [h1, h2, ← ByteArray.append_assoc, ByteArray.append_toByteArray_singleton]
+
+/-- every byte is below 128 -/
+def Ascii (b : ByteArray) : Prop := ∀ x ∈ b.data.toList, x < 128
+
+theorem utf8Encode_ascii (l : List UInt8) (h : ∀ x ∈ l, x < 128) :
+    (l.map fun x => Char.ofNat x.toNat).utf8Encode = l.toByteArray := by
+  induction l with
+  | nil => simp
+  | cons x xs ih =>
+    have hx : x < 128 := h x (by simp)
+    rw [List.map_cons, List.utf8Encode_cons, ih (fun y hy => h y (by simp [hy])), List.utf8Encode_singleton]
+    have hn : x.toNat < 128 := by simpa [UInt8.lt_iff_toNat_lt] using hx
+    have hv : Nat.isValidChar x.toNat := Or.inl (by omega)
+    have hc : (Char.ofNat x.toNat).val.toNat = x.toNat := by
+      simp [Char.ofNat, hv, Char.ofNatAux]
+    have : String.utf8EncodeChar (Char.ofNat x.toNat) = [x] := by
+      simp only [String.utf8EncodeChar, hc]
+      rw [if_pos (by omega)]
+      simp
+    rw [this]
+    exact (List.toByteArray_append (l := [x]) (l' := xs)).symm
+
+theorem ascii_push (acc : ByteArray) (v : UInt8) (h : Ascii acc) (hv : v < 128) : Ascii (acc.push v) := by
+  intro x hx
+  simp only [ByteArray.push, Array.toList_push, List.mem_append, List.mem_singleton] at hx
+  rcases hx with hx | rfl
+  · exact h x hx
+  · exact hv
+
+theorem ascii_get (b : ByteArray) (h : Ascii b) (i : Nat) : b[i]! < 128 := by
+  by_cases hi : i < b.size
+  · have : b[i]! = b[i] := by simp [hi]
+    rw [this]
+    have hi' : i < b.data.size := by simpa using hi
+    have hmem : b.data[i] ∈ b.data := Array.getElem_mem hi'
+    exact h _ (by simp [ByteArray.getElem_eq_getElem_data])
+  · have : b[i]! = default := by simp [getElem!_neg, hi]
+    rw [this]; decide
+
+theorem foldl_push_ascii (g : Nat → UInt8) (hg : ∀ a, g a < 128) (l : List Nat) (acc : ByteArray) (h : Ascii acc) :
+    Ascii (l.foldl (fun b a => b.push (g a)) acc) := by
+  induction l generalizing acc with
+  | nil => exact h
+  | cons a l ih => exact ih _ (ascii_push _ _ h (hg a))
+
+theorem ascii_emptyWithCapacity (n : Nat) : Ascii (ByteArray.emptyWithCapacity n) := by
+  intro x hx
+  have : (ByteArray.emptyWithCapacity n).data.toList = [] := rfl
+  rw [this] at hx
+  cases hx
+
+theorem ascii_reverseMapBytes (f : UInt8 → UInt8) (hf : ∀ x, x < 128 → f x < 128) (b : ByteArray) (hb : Ascii b) :
+    Ascii (reverseMapBytes f b) := by
+  unfold reverseMapBytes
+  simp
+  exact foldl_push_ascii (fun a => f b[b.size - 1 - a]!) (fun a => hf _ (ascii_get b hb _)) _ _
+    (ascii_emptyWithCapacity b.size)
+
+theorem isValidUTF8_of_ascii (b : ByteArray) (h : Ascii b) : b.IsValidUTF8 :=
+  .intro (b.data.toList.map fun x => Char.ofNat x.toNat) (by
+    rw [utf8Encode_ascii _ h]
+    apply ByteArray.ext
+    simp [List.data_toByteArray])
+
+theorem fromUTF8!_toUTF8_ascii (b : ByteArray) (h : Ascii b) : (String.fromUTF8! b).toUTF8 = b := by
+  unfold String.fromUTF8!
+  rw [dif_pos (isValidUTF8_of_ascii b h)]
+  rfl
+
+theorem fromUTF8!_toByteArray_ascii (b : ByteArray) (h : Ascii b) : (String.fromUTF8! b).toByteArray = b :=
+  fromUTF8!_toUTF8_ascii b h
+
+theorem complementByte_lt (x : UInt8) (hx : x < 128) : complementByte x < 128 := by
+  unfold complementByte
+  repeat' split
+  all_goals first | decide | exact hx
+
+theorem samSequenceB_eq (record : FastqRecord) (strand : Strand) (hl : Ascii record.letters)
+    (hq : Ascii record.quality.toUTF8) :
+    ((samSequence record strand).1.toUTF8, (samSequence record strand).2.toUTF8) = samSequenceB record strand := by
+  unfold samSequence samSequenceB
+  split
+  · rfl
+  · cases strand
+    · simp [fromUTF8!_toByteArray_ascii _ hl]
+    · have hq' : Ascii record.quality.toByteArray := hq
+      simp [fromUTF8!_toByteArray_ascii _ (ascii_reverseMapBytes _ complementByte_lt _ hl),
+        fromUTF8!_toByteArray_ascii _ (ascii_reverseMapBytes id (fun x hx => hx) _ hq')]
+
+/-- one more tab-separated field -/
+def stepB (acc : ByteArray) (t : String) : ByteArray := (acc.push 9) ++ t.toUTF8
+
+theorem foldl_stepB_append (a : ByteArray) (ys : List String) : ∀ c : ByteArray,
+    ys.foldl stepB (a ++ c) = a ++ ys.foldl stepB c := by
+  induction ys with
+  | nil => intro c; rfl
+  | cons y ys ih =>
+    intro c
+    simp only [List.foldl_cons]
+    have : stepB (a ++ c) y = a ++ stepB c y := by
+      simp [stepB, push_append, ByteArray.append_assoc]
+    rw [this, ih]
+
+theorem intercalate_tab_bytes (x : String) (xs : List String) :
+    ("\t".intercalate (x :: xs)).toUTF8 = xs.foldl stepB x.toUTF8 := by
+  induction xs generalizing x with
+  | nil => simp
+  | cons y ys ih =>
+    rw [String.intercalate_cons_cons]
+    simp only [String.toUTF8_eq_toByteArray, String.toByteArray_append] at ih ⊢
+    rw [ih y, List.foldl_cons]
+    have h9 : "\t".toByteArray = [9].toByteArray := by decide
+    have hs : stepB x.toByteArray y = (x.toByteArray ++ "\t".toByteArray) ++ y.toByteArray := by
+      simp [stepB, h9]
+    rw [hs, foldl_stepB_append]
+
+theorem samLineB_eq (b : ByteArray) (qname : String) (flag : Nat) (rname : String) (pos mapq : Nat) (cigar rnext : String)
+    (pnext : Nat) (tlen : Int) (seq qual : String) (tags : List String) :
+    samLineB b qname flag rname pos mapq cigar rnext pnext tlen seq.toUTF8 qual.toUTF8 tags =
+      b ++ (samLine qname flag rname pos mapq cigar rnext pnext tlen seq qual tags).toUTF8 := by
+  unfold samLineB samLine
+  rw [List.cons_append, intercalate_tab_bytes]
+  simp only [List.cons_append, List.nil_append, List.foldl_cons, pushNat_eq, pushInt_eq, stepB]
+  simp only [push_append, ByteArray.append_assoc]
+  exact foldl_stepB_append b tags _
+
+/-- the letters and qualities of a record are ASCII -/
+def RecordAscii (r : FastqRecord) : Prop := Ascii r.letters ∧ Ascii r.quality.toUTF8
+
+theorem unmappedLineB_eq (b : ByteArray) (record : FastqRecord) (which : Mate) (tags : List String)
+    (h : RecordAscii record) :
+    unmappedLineB b record which tags = b ++ (unmappedLine record which tags).toUTF8 := by
+  unfold unmappedLineB unmappedLine
+  have e := samSequenceB_eq record .forward h.1 h.2
+  rcases hS : samSequence record .forward with ⟨s1, s2⟩
+  rw [hS] at e
+  rw [← e]
+  exact samLineB_eq _ _ _ _ _ _ _ _ _ _ s1 s2 _
+
+theorem mappedLineB_eq (b : ByteArray) (chromosomes : ChromosomeList) (record : FastqRecord) (which : Mate)
+    (mate other : MateReport) (answer : PairAnswer) (h : RecordAscii record) :
+    mappedLineB b chromosomes record which mate other answer =
+      b ++ (mappedLine chromosomes record which mate other answer).toUTF8 := by
+  unfold mappedLineB mappedLine
+  have e := samSequenceB_eq record mate.placement.strand h.1 h.2
+  rcases hS : samSequence record mate.placement.strand with ⟨s1, s2⟩
+  rw [hS] at e
+  rw [← e]
+  exact samLineB_eq _ _ _ _ _ _ _ _ _ _ s1 s2 _
+
+/-- the text `samChunk` builds from the lines of one pair -/
+def linesText (lines : List String) (text : String) : String := lines.foldl (fun text line => text ++ line ++ "\n") text
+
+theorem linesText_append (lines : List String) : ∀ text : String, linesText lines text = text ++ linesText lines "" := by
+  induction lines with
+  | nil => intro text; simp [linesText]
+  | cons l ls ih =>
+    intro text
+    simp only [linesText, List.foldl_cons] at ih ⊢
+    rw [ih (text ++ l ++ "\n"), ih ("" ++ l ++ "\n")]
+    simp [String.append_assoc]
+
+theorem samLinesB_eq (b : ByteArray) (chromosomes : ChromosomeList) (record1 record2 : FastqRecord) (result : PairResult)
+    (h1 : RecordAscii record1) (h2 : RecordAscii record2) :
+    samLinesB b chromosomes record1 record2 result =
+      b ++ (linesText (samLines chromosomes record1 record2 result) "").toUTF8 := by
+  have hnl : "\n".toByteArray = [10].toByteArray := by decide
+  unfold samLinesB samLines
+  split
+  · simp only [linesText, List.foldl_cons, List.foldl_nil, String.toUTF8_eq_toByteArray, String.toByteArray_append,
+      unmappedLineB_eq _ _ _ _ h1, unmappedLineB_eq _ _ _ _ h2, hnl]
+    simp [push_append, ByteArray.append_assoc]
+  · split
+    · simp only [linesText, List.foldl_cons, List.foldl_nil, String.toUTF8_eq_toByteArray, String.toByteArray_append,
+        mappedLineB_eq _ _ _ _ _ _ _ h1, mappedLineB_eq _ _ _ _ _ _ _ h2, hnl]
+      simp [push_append, ByteArray.append_assoc]
+    · simp only [linesText, List.foldl_cons, List.foldl_nil, String.toUTF8_eq_toByteArray, String.toByteArray_append,
+        unmappedLineB_eq _ _ _ _ h1, unmappedLineB_eq _ _ _ _ h2, hnl]
+      simp [push_append, ByteArray.append_assoc]
+
+theorem foldl_samLinesB (chromosomes : ChromosomeList) (l : List ((FastqRecord × FastqRecord) × PairResult))
+    (h : ∀ x ∈ l, RecordAscii x.1.1 ∧ RecordAscii x.1.2) : ∀ text : String,
+    l.foldl (fun bytes ((record1, record2), result) => samLinesB bytes chromosomes record1 record2 result) text.toUTF8 =
+      (l.foldl (fun text ((record1, record2), result) => linesText (samLines chromosomes record1 record2 result) text) text).toUTF8 := by
+  induction l with
+  | nil => intro text; rfl
+  | cons x l ih =>
+    intro text
+    obtain ⟨⟨r1, r2⟩, result⟩ := x
+    have hx := h _ (List.mem_cons_self ..)
+    simp only [List.foldl_cons]
+    have : samLinesB text.toUTF8 chromosomes r1 r2 result =
+        (linesText (samLines chromosomes r1 r2 result) text).toUTF8 := by
+      rw [samLinesB_eq _ _ _ _ _ hx.1 hx.2, linesText_append (samLines chromosomes r1 r2 result) text]
+      simp [String.toUTF8_eq_toByteArray, String.toByteArray_append]
+    rw [this]
+    exact ih (fun y hy => h y (List.mem_cons_of_mem _ hy)) _
+
+/-- **The byte SAM writer produces exactly the bytes of `samChunk`**, for chunks whose letters and qualities are ASCII
+(`isDnaByte` and `'!'..'~'`, checked by the FASTQ reader; trimming only shortens them). -/
+theorem samChunkB_eq (chromosomes : ChromosomeList) (chunk : Array (FastqRecord × FastqRecord))
+    (results : List PairResult) (parts : Nat)
+    (h : ∀ p ∈ chunk, RecordAscii p.1 ∧ RecordAscii p.2) :
+    samChunkB chromosomes chunk results parts = samChunk chromosomes chunk results parts := by
+  unfold samChunkB samChunk
+  have hp : ∀ part, ∀ x ∈ ((chunk.zip results.toArray).extract (part * ((((chunk.zip results.toArray).size + parts - 1) / parts)))
+      ((part + 1) * ((((chunk.zip results.toArray).size + parts - 1) / parts)))).toList, RecordAscii x.1.1 ∧ RecordAscii x.1.2 := by
+    intro part x hx
+    obtain ⟨a, b⟩ := x
+    have hx1 : (a, b) ∈ chunk.zip results.toArray := by
+      obtain ⟨k, hm, hk⟩ := Array.mem_extract_iff_getElem.1 (Array.mem_toList_iff.1 hx)
+      rw [← hk]
+      exact Array.getElem_mem _
+    exact h _ (Array.of_mem_zip hx1).1
+  dsimp only
+  congr 1
+  apply List.map_congr_left
+  intro part _
+  have := foldl_samLinesB chromosomes ((chunk.zip results.toArray).extract (part * ((((chunk.zip results.toArray).size + parts - 1) / parts)))
+      ((part + 1) * ((((chunk.zip results.toArray).size + parts - 1) / parts)))).toList (hp part) ""
+  simp only [Array.foldl_toList] at this
+  show Task.spawn (fun _ => _) = Task.spawn (fun _ => _)
+  congr 1
+  funext _
+  simpa [linesText] using this
+
+end Spec
+
+#print axioms Spec.samChunkB_eq
