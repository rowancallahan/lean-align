+/-! ## Byte writer. The same text as `samLines` / `samChunk`, appended to a `ByteArray` without building Strings
+for the numbers, SEQ and QUAL (Proofs/SamBytes.lean: `samChunkB_eq`, equal to `samChunk` when the letters and
+qualities are ASCII, which the FASTQ reader checks). -/
+
+-- the decimal digits of `n`, appended to `b` (= `b ++ (toString n).toUTF8`, `pushNat_eq`)
+def pushNat (b : ByteArray) (n : Nat) : ByteArray :=
+  if h : n < 10 then b.push (48 + n.toUInt8) else (pushNat b (n / 10)).push (48 + (n % 10).toUInt8)
+termination_by n
+decreasing_by omega
+
+-- `toString i` appended to `b` (`pushInt_eq`)
+def pushInt (b : ByteArray) (i : Int) : ByteArray :=
+  if i < 0 then pushNat (b.push 45) i.natAbs else pushNat b i.toNat
+
+-- `samSequence` as bytes: SEQ and QUAL
+def samSequenceB (record : FastqRecord) (strand : Strand) : ByteArray × ByteArray :=
+  if record.letters.isEmpty then ("*".toUTF8, "*".toUTF8) else
+  match strand with
+  | .forward => (record.letters, record.quality.toUTF8)
+  | .reverse => (reverseMapBytes complementByte record.letters, reverseMapBytes id record.quality.toUTF8)
+
+-- `samLine` appended to `b`, ending without the newline
+def samLineB (b : ByteArray) (qname : String) (flag : Nat) (rname : String) (pos mapq : Nat) (cigar rnext : String)
+    (pnext : Nat) (tlen : Int) (seq qual : ByteArray) (tags : List String) : ByteArray :=
+  let b := pushNat ((b ++ qname.toUTF8).push 9) flag
+  let b := (b.push 9) ++ rname.toUTF8
+  let b := pushNat (b.push 9) pos
+  let b := pushNat (b.push 9) mapq
+  let b := (b.push 9) ++ cigar.toUTF8
+  let b := (b.push 9) ++ rnext.toUTF8
+  let b := pushNat (b.push 9) pnext
+  let b := pushInt (b.push 9) tlen
+  let b := ((b.push 9) ++ seq).push 9 ++ qual
+  tags.foldl (fun b tag => (b.push 9) ++ tag.toUTF8) b
+
+def mappedLineB (b : ByteArray) (chromosomes : ChromosomeList) (record : FastqRecord) (which : Mate)
+    (mate other : MateReport) (answer : PairAnswer) : ByteArray :=
+  let flag := flagPaired + flagProperPair + mateFlag which +
+    reverseFlag mate.placement.strand flagReverse + reverseFlag other.placement.strand flagMateReverse
+  let rname := (chromosomes[mate.placement.chromosome]?.map (·.1)).getD "*"
+  let rnext := if mate.placement.chromosome = other.placement.chromosome then "=" else
+    (chromosomes[other.placement.chromosome]?.map (·.1)).getD "*"
+  let left := min mate.placement.start other.placement.start
+  let right := max mate.placement.stop other.placement.stop
+  let leftmost := mate.placement.start < other.placement.start ||
+    (mate.placement.start = other.placement.start && which = .one)
+  let tlen : Int := if leftmost then right - left else -((right - left : Nat) : Int)
+  let (seq, qual) := samSequenceB record mate.placement.strand
+  samLineB b (samName record.name) flag rname (mate.placement.start + 1) (mapq answer)
+    (cigarText mate.cigar) rnext (other.placement.start + 1) tlen seq qual
+    (s!"AS:i:{mate.score}" :: answerTags answer)
+
+def unmappedLineB (b : ByteArray) (record : FastqRecord) (which : Mate) (tags : List String) : ByteArray :=
+  let flag := flagPaired + flagUnmapped + flagMateUnmapped + mateFlag which
+  let (seq, qual) := samSequenceB record .forward
+  samLineB b (samName record.name) flag "*" 0 0 "*" "*" 0 0 seq qual tags
+
+-- the two SAM lines of one pair (with their newlines) appended to `b`
+def samLinesB (b : ByteArray) (chromosomes : ChromosomeList) (record1 record2 : FastqRecord) (result : PairResult) :
+    ByteArray :=
+  match result with
+  | .trimmedAway mate =>
+      let tags := [s!"XT:Z:trimmedAway{if mate = .one then 1 else 2}"]
+      (unmappedLineB b record1 .one tags).push 10 |> (unmappedLineB · record2 .two tags) |>.push 10
+  | .aligned answer =>
+      match answer.found with
+      | some pair =>
+          (mappedLineB b chromosomes record1 .one pair.mate1 pair.mate2 answer).push 10
+            |> (mappedLineB · chromosomes record2 .two pair.mate2 pair.mate1 answer) |>.push 10
+      | none =>
+          (unmappedLineB b record1 .one (answerTags answer)).push 10
+            |> (unmappedLineB · record2 .two (answerTags answer)) |>.push 10
+
+-- `samChunk` with the byte writer
+def samChunkB (chromosomes : ChromosomeList) (chunk : Array (FastqRecord × FastqRecord))
+    (results : List PairResult) (parts : Nat) : ByteArray :=
+  let pairs := chunk.zip results.toArray
+  let size := (pairs.size + parts - 1) / parts
+  let tasks := (List.range parts).map fun part => Task.spawn fun _ =>
+    (pairs.extract (part * size) ((part + 1) * size)).foldl (init := ByteArray.empty)
+      fun bytes ((record1, record2), result) => samLinesB bytes chromosomes record1 record2 result
+  tasks.foldl (fun bytes task => bytes ++ task.get) ByteArray.empty
+
 end Spec
