Shim speed patch for Rowan (frozen files: NOT applied).   git apply Testing/notes/shim_speed.patch
Base: festive-fermi 562a2f5 (adapter trim merged). Touches Proofs/Fastq.lean, Proofs/Sam.lean and their copies
Spec/Fastq.lean, Spec/Sam.lean (the same edits).

Items, measured cumulatively at 562a2f5 (callgrind Ir of the shim, first 2000 pairs, index load included; base
NovaSeq 985.5M, HiSeq hg002 2x250 1359.0M). SAM byte-identical to base at every step on both subsets; with all four
items, also identical on the four full 200k sets (NovaSeq, mason, low, HiSeq), and CI_check.sh passes.
| step | change | NovaSeq | HiSeq |
| 1 | reverseMapBytes @[specialize]: f (complementByte / id) was a closure call per byte | -32.1M (-3.3%) | -49.1M (-3.6%) |
| 2 | samName / mateName: (name.takeWhile (· != ' ')).toString instead of (name.splitOn " ").headD _ | -29.3M (-3.0%) | -20.3M (-1.5%) |
| 3 | findNewline: USize loop with uget (findNewlineU), the while loop kept as the fallback | -14.4M (-1.5%) | -21.7M (-1.6%) |
| 4 | FastqRecord.quality : ByteArray (was String): no UTF-8 round trips when reading / trimming; SAM QUAL decoded once | -26.0M (-2.6%) | -40.3M (-3.0%) |
| all | | 883.8M (-10.3%) | 1227.6M (-9.7%) |
Notes:
- Step 2 gives the same string: the part before the first space (splitOn with a non-empty separator always has a
  first piece; with no space it is the whole name).
- Step 3's findNewlineU is not proved equal to the while loop (needs a lemma if the file must stay proof-equal);
  it returns the same index on the four full sets.
- Step 4 changes a Spec structure's field type (FastqRecord.quality); trimRecord now hands the quality bytes to
  AdapterTrim.cutTruSeq / ReadTrim.trimRead directly. Nothing else in Spec/, Main.lean or the proofs reads the
  field. The SAM text is unchanged.

diff --git a/Proofs/Fastq.lean b/Proofs/Fastq.lean
index b656414..7a468c6 100644
--- a/Proofs/Fastq.lean
+++ b/Proofs/Fastq.lean
@@ -12,7 +12,7 @@ namespace Spec
 structure FastqRecord where
   name    : String
   letters : ByteArray
-  quality : String
+  quality : ByteArray
 
 -- a FASTQ file read in blocks: the unread bytes are `buffer` from `pos` on
 structure FastqReader where
@@ -24,7 +24,23 @@ def FastqReader.ofHandle (handle : IO.FS.Handle) : IO FastqReader :=
   return { handle, buffer := ← IO.mkRef ByteArray.empty, pos := ← IO.mkRef 0 }
 
 -- the first newline byte at or after `i` (or `bytes.size` when there is none)
-def findNewline (bytes : ByteArray) (i : Nat) : Nat := Id.run do
+theorem usize_le' (a : ByteArray) : a.usize.toNat ≤ a.size := by
+  show a.size.toUSize.toNat ≤ a.size
+  rw [Nat.toUSize_eq, USize.toNat_ofNat']; exact Nat.mod_le _ _
+
+def findNewlineU (bytes : @& ByteArray) (j : USize) : USize :=
+  if h : j < bytes.usize then
+    if bytes.uget j (Nat.lt_of_lt_of_le h (usize_le' bytes)) != 10 then findNewlineU bytes (j + 1) else j
+  else j
+termination_by bytes.usize.toNat - j.toNat
+decreasing_by
+  have h' : j.toNat < bytes.usize.toNat := h
+  have := USize.toNat_lt_size bytes.usize
+  have hs : USize.size = 2 ^ System.Platform.numBits := rfl
+  rw [USize.toNat_add, USize.toNat_one, Nat.mod_eq_of_lt (by omega)]; omega
+
+def findNewline (bytes : ByteArray) (i : Nat) : Nat :=
+  if i < bytes.size ∧ bytes.size < 4294967295 then (findNewlineU bytes i.toUSize).toNat else Id.run do
   let mut j := i
   while j < bytes.size && bytes[j]! != 10 do
     j := j + 1
@@ -55,11 +71,11 @@ def readFastqRecord (reader : FastqReader) : IO (Option FastqRecord) := do
   let some _plus ← reader.line | return none
   let some quality ← reader.line | return none
   return some { name := String.fromUTF8! (header.extract 1 header.size), letters,
-                quality := String.fromUTF8! quality }
+                quality := quality }
 
 -- a read's name without its comment (after the first space) and without a trailing "/1" or "/2"
 def mateName (name : String) : String :=
-  let base := (name.splitOn " ").headD ""
+  let base := (name.takeWhile (· != ' ')).toString
   if base.endsWith "/1" || base.endsWith "/2" then String.ofList (base.toList.dropLast.dropLast) else base
 
 -- shortest mate kept after trimming; shorter mates become empty (trimmed away)
@@ -69,12 +85,12 @@ def minLength : Nat := 25
 -- and qualities at the first TruSeq adapter, keep the best window, and drop a mate shorter than
 -- `minLength`; a mate with nothing worth keeping comes back with no letters (trimmed away)
 def trimRecord (record : FastqRecord) : FastqRecord :=
-  let (letters, qual) := AdapterTrim.cutTruSeq record.letters record.quality.toUTF8
+  let (letters, qual) := AdapterTrim.cutTruSeq record.letters record.quality
   let (letters, qual) := match ReadTrim.trimRead letters qual with
     | some (s, e) => (letters.extract s e, qual.extract s e)
     | none => (ByteArray.empty, ByteArray.empty)
   let (letters, qual) := AdapterTrim.dropShort minLength letters qual
-  { record with letters, quality := String.fromUTF8! qual }
+  { record with letters, quality := qual }
 
 -- up to `size` pairs, reading the two FASTQ files in step; stops with an error if two mates'
 -- names differ or one file ends before the other (the files are out of step)
@@ -85,7 +101,7 @@ def readChunk (reads1 reads2 : FastqReader) (size : Nat) : IO (Array (FastqRecor
     | some record1, some record2 =>
       if mateName record1.name != mateName record2.name then
         throw (IO.userError s!"FASTQ files out of step: mate names {record1.name} / {record2.name}")
-      if record1.letters.size != record1.quality.utf8ByteSize || record2.letters.size != record2.quality.utf8ByteSize then
+      if record1.letters.size != record1.quality.size || record2.letters.size != record2.quality.size then
         throw (IO.userError s!"FASTQ record {record1.name}: sequence and quality lengths differ")
       chunk := chunk.push (trimRecord record1, trimRecord record2)
     | none, none => break
