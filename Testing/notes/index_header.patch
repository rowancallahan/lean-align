diff --git a/Testing/scripts/index_code_hash.sh b/Testing/scripts/index_code_hash.sh
new file mode 100644
index 0000000..496b3b5
--- /dev/null
+++ b/Testing/scripts/index_code_hash.sh
@@ -0,0 +1,17 @@
+#!/bin/sh
+# The index code hash compiled into lean-align (Spec/IndexHeader.lean `indexCodeHash`, written to INDEX.header by `build`,
+# checked by `map`): sha256 of the `shasum -a 256` lines of the files that decide the index bytes.
+#   sh Testing/scripts/index_code_hash.sh           print it
+#   sh Testing/scripts/index_code_hash.sh --check   exit 1 unless Spec/IndexHeader.lean holds it (CI_check.sh)
+# After changing any of these files: paste the printed hash into Spec/IndexHeader.lean, rebuild, re-run `build` on every index.
+set -eu
+export LC_ALL=C
+cd "$(dirname "$0")/../.."
+h=$(shasum -a 256 Proofs/Aligner.lean Proofs/Index.lean Proofs/Heavy.lean Proofs/HeavyBuild.lean Proofs/LastResort.lean \
+  Aligner/index/minimizer/*.lean Aligner/index/packed_genome/*.lean | shasum -a 256 | cut -c1-64)
+if [ "${1:-}" = --check ]; then
+  grep -q "^def indexCodeHash : String := \"$h\"\$" Spec/IndexHeader.lean && echo "index code hash ok ($h)" ||
+    { echo "FAIL: index code changed: put \"$h\" in Spec/IndexHeader.lean (indexCodeHash)"; exit 1; }
+else
+  echo "$h"
+fi
