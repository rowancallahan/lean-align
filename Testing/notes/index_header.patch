index 0000000..48e496e
--- /dev/null
+++ b/Spec/IndexHeader.lean
@@ -0,0 +1,36 @@
+/-! # INDEX.header: which code and which genome an index was built from. Unproved (trusted) plumbing for the shim.
+One line, written by `build` after the index: "lean-align-index<TAB>code <indexCodeHash><TAB>genome <FNV-1a 64 of the FASTA bytes>".
+`map` stops before it reads the index when the header is missing or its code hash is not this binary's
+(an index from older code would load to nothing and every pair would come out unmapped). The genome hash is
+recorded for a later check against the FASTA; `map` does not have the FASTA. -/
+
+namespace Spec
+
+-- regenerate: sh Testing/scripts/index_code_hash.sh (sha256 of the index-building files; CI_check.sh checks it)
+def indexCodeHash : String := "c2e13edf82edcb511b79bd3321b8b8b5593ea27ab3a1d409e5ef7cb06e00193c"
+
+-- FNV-1a 64 bit over a file's bytes, read in 1 MiB pieces
+def fileFnv1a (path : String) : IO UInt64 := do
+  let handle ← IO.FS.Handle.mk path .read
+  let mut h : UInt64 := 14695981039346656037
+  repeat
+    let piece ← handle.read 1048576
+    if piece.isEmpty then break
+    for b in piece do
+      h := (h ^^^ b.toUInt64) * 1099511628211
+  return h
+
+def writeIndexHeader (genomePath indexPath : String) : IO Unit := do
+  IO.FS.writeFile (indexPath ++ ".header") s!"lean-align-index\tcode {indexCodeHash}\tgenome {← fileFnv1a genomePath}\n"
+
+-- throws (stops the run) unless INDEX.header is there and was written by this index code
+def checkIndexHeader (indexPath : String) : IO Unit := do
+  let path := indexPath ++ ".header"
+  unless ← System.FilePath.pathExists path do
+    throw (IO.userError s!"{path} is missing: the index was built by older code or not by `build`; re-run build")
+  let ["lean-align-index", code, genome] := ((← IO.FS.readFile path).replace "\n" "").splitOn "\t"
+    | throw (IO.userError s!"{path}: not an index header")
+  unless code == s!"code {indexCodeHash}" && genome.startsWith "genome " do
+    throw (IO.userError s!"{path}: index built by different index code ({code}; this binary: code {indexCodeHash}); re-run build")
+
+end Spec
