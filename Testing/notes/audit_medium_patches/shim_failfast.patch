-  let some _plus ← reader.line | return none
-  let some quality ← reader.line | return none
+  let some letters ← reader.line | badFastq "file ends inside a record"
+  let some plus ← reader.line | badFastq "file ends inside a record"
+  let some quality ← reader.line | badFastq "file ends inside a record"
+  unless 0 < header.size && header[0]! == 64 && allBytes (fun b => 32 ≤ b && b ≤ 126) header do badFastq "header line is not '@' + printable ASCII"
+  unless 0 < plus.size && plus[0]! == 43 do badFastq "third line of a record does not start with '+'"
+  unless allBytes isDnaByte letters do badFastq "letters other than A C G T N (lowercase, IUPAC)"
+  unless allBytes (fun b => 33 ≤ b && b ≤ 126) quality do badFastq "quality outside '!'..'~'"
   return some { name := String.fromUTF8! (header.extract 1 header.size), letters,
                 quality := String.fromUTF8! quality }
 
