@@ -47,11 +47,27 @@ def FastqReader.line (reader : FastqReader) : IO (Option ByteArray) := do
     reader.pos.set 0
   return none
 
+-- every byte satisfies `p`
+def allBytes (p : UInt8 → Bool) (bytes : ByteArray) : Bool := Id.run do
+  for i in [0:bytes.size] do
+    if !p bytes[i]! then return false
+  return true
+
+-- the letters the spec's `GenomeIsDNA` allows: A C G T N
+def isDnaByte (b : UInt8) : Bool := b == 65 || b == 67 || b == 71 || b == 84 || b == 78
+
+-- a FASTQ line is bad input: stop the run (all bytes are checked to be printable ASCII before any String is made)
+def badFastq (what : String) : IO α := throw (IO.userError s!"FASTQ: {what}")
+
