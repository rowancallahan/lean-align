/-!
# 1. Alignment: a walk, its exact score, and optimality

Statements only: every proof is `sorry`. The proved version is new_spec/Alignment.lean.
Imports nothing. The definitions copied from spec/AlignmentSpec.lean are unchanged.

Build from the repository root:

    mkdir -p .lake/build/lib/lean/new_spec/statements
    lake env lean -o .lake/build/lib/lean/new_spec/statements/Alignment.olean new_spec/statements/Alignment.lean
-/

namespace NewSpec

-- One column of an alignment, i.e. one step of a monotone lattice path.
inductive Step where
  | diag  -- consume a letter from both strings (match or mismatch)
  | gapX  -- gap in x: consume a letter from y only (insertion)
  | gapY  -- gap in y: consume a letter from x only (deletion)
deriving Repr, BEq, DecidableEq

-- How many letters of x (respectively y) one step consumes.
def xConsumed : Step → Nat
  | .diag => 1
  | .gapY => 1
  | .gapX => 0

def yConsumed : Step → Nat
  | .diag => 1
  | .gapX => 1
  | .gapY => 0

-- The four scoring parameters.  A gap run of length k costs
-- gapOpen + k * gapExtend (the "o + k·e" convention): every gap column
-- pays gapExtend, and the first column of a run additionally pays
-- gapOpen.
structure Scoring where
  matchScore    : Int
  mismatchScore : Int
  gapOpen       : Int
  gapExtend     : Int

abbrev Read := List Char
abbrev Cigar := Array (Step × Nat)

-- Walk one alignment along both strings and add up its score.  The
-- one piece of carried state, the previous step, is the entire content
-- of "affine": a gap column pays gapOpen exactly when the previous
-- column was not a gap in the same string.
--
-- The final catch-all case returns 0.  It is unreachable whenever the
-- path satisfies IsMonotoneWalk, and only valid paths are ever scored.
def scoreWalk (sc : Scoring) :
    List Step → List Char → List Char → Option Step → Int
  | [], _, _, _ => 0
  | .diag :: rest, x :: xs, y :: ys, _ =>
      (if x = y then sc.matchScore else sc.mismatchScore)
        + scoreWalk sc rest xs ys (some .diag)
  | .gapX :: rest, xs, _ :: ys, prev =>
      (if prev = some .gapX then sc.gapExtend
       else sc.gapOpen + sc.gapExtend)
        + scoreWalk sc rest xs ys (some .gapX)
  | .gapY :: rest, _ :: xs, ys, prev =>
      (if prev = some .gapY then sc.gapExtend
       else sc.gapOpen + sc.gapExtend)
        + scoreWalk sc rest xs ys (some .gapY)
  | _, _, _, _ => 0

-- Every monotone lattice path over xs and ys, generated by branching
-- three ways at every position until both strings are exhausted.
def allPaths : List Char → List Char → List (List Step)
  | [], [] => [[]]
  | [], _ :: ys => (allPaths [] ys).map (Step.gapX :: ·)
  | _ :: xs, [] => (allPaths xs []).map (Step.gapY :: ·)
  | x :: xs, y :: ys =>
      ((allPaths xs ys).map (Step.diag :: ·)) ++
      ((allPaths (x :: xs) ys).map (Step.gapX :: ·)) ++
      ((allPaths xs (y :: ys)).map (Step.gapY :: ·))

/-- Scores are maximized. Penalties are their negatives, and are minimized.
A length-k gap costs 6 + 2*k, including the extension on its first column.
A penalty cap is NOT a count of mismatches/indels. -/
def defaultScoring : Scoring :=
  { matchScore := 0, mismatchScore := -4, gapOpen := -6, gapExtend := -2 }

/-- x is the read; y is the reference window. `gapX` consumes only y,
`gapY` only x. These are structured steps, not SAM I/D text conventions. -/
def IsMonotoneWalk (path : List Step) (x y : Read) : Prop :=
  (path.map xConsumed).sum = x.length ∧
  (path.map yConsumed).sum = y.length

instance (path : List Step) (x y : Read) : Decidable (IsMonotoneWalk path x y) :=
  inferInstanceAs (Decidable (_ ∧ _))

/-- Start the affine scorer with no previous step. On a diagonal, score the
two letters; on a gap, pay extension plus opening if the gap type changed.
Only scores of valid walks carry semantic meaning. -/
def walkScore (x y : Read) (path : List Step) : Int :=
  scoreWalk defaultScoring path x y none

def expandCigar (runs : Cigar) : List Step :=
  runs.toList.flatMap fun (step, count) => List.replicate count step

/-- THE NAIVE ALIGNER: enumerate all paths, score them, select a maximum.
Its internal path tie-break does not constrain a fast kernel's CIGAR. -/
def alignSpec (x y : Read) : Option (List Step × Int) :=
  ((allPaths x y).map fun p => (p, walkScore x y p)).maxOn? Prod.snd

def AlignmentSound (x y : Read) (runs : Cigar) (score : Int) : Prop :=
  IsMonotoneWalk (expandCigar runs) x y ∧
  walkScore x y (expandCigar runs) = score

def AlignmentOptimal (x y : Read) (score : Int) : Prop :=
  ∀ path, IsMonotoneWalk path x y → walkScore x y path ≤ score

/-- Slot for a replacement alignment kernel: totality, soundness AND optimality. -/
def AlignmentKernelCorrect (kernel : Read → Read → Option (Cigar × Int)) : Prop :=
  ∀ x y, (∃ result, kernel x y = some result) ∧
    ∀ runs score, kernel x y = some (runs, score) →
      AlignmentSound x y runs score ∧ AlignmentOptimal x y score

theorem monotone_iff_enumerated (x y : Read) (path : List Step) :
    IsMonotoneWalk path x y ↔ path ∈ allPaths x y := by
  sorry

theorem alignSpec_sound_optimal (x y : Read) (path : List Step) (score : Int)
    (h : alignSpec x y = some (path, score)) :
    IsMonotoneWalk path x y ∧ walkScore x y path = score ∧ AlignmentOptimal x y score := by
  sorry

-- Executable examples (`#guard` runs the definitions; it is not a proof).
#guard walkScore ['A'] ['C'] [.diag] == -4
#guard walkScore [] ['A', 'C'] [.gapX, .gapX] == -10
#guard alignSpec ['A', 'C'] ['A', 'C'] == some ([.diag, .diag], 0)
#guard alignSpec ['A'] ['C'] == some ([.diag], -4)

end NewSpec
